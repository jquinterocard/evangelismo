# URL pública donde quedará publicada la app (sin barra final).
# Se usa para construir los enlaces de los códigos QR. Si se deja vacía,
# el generador usa la dirección actual del navegador.
# Ejemplos: https://mi-proyecto.vercel.app  |  https://usuario.github.io/evangelizmo
NEXT_PUBLIC_SITE_URL=

# Subruta de publicación. Vacía en Vercel o dominio propio; "/nombre-del-repo" en GitHub Pages.
NEXT_PUBLIC_BASE_PATH=

# Supabase (opcional). Solo la URL del proyecto y la clave pública "anon".
# NUNCA pongas aquí la clave service_role: el frontend es público.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo desarrollo: permite abrir `npm run dev` desde otra dirección de la red local
# (por ejemplo desde tu celular). Admite comodines. Ejemplo: 192.168.1.*
DEV_ALLOWED_ORIGINS=
